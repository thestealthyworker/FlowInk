# Environment variables for FlowInk's non-dashboard runtimes: Supabase Edge
# Functions and the GitHub Actions statement-reconciliation jobs. Each
# runtime reads only its own secret store (see README.md "Secrets — four
# runtimes, four stores") — this file documents every value across all of
# them so you have one place to look, not one place to load them from.
#
# Edge Functions: `supabase secrets set KEY=value` (see scripts/setup_secrets.sh).
# GitHub Actions: repo Settings -> Secrets and variables -> Actions.
# Never commit a real .env with these filled in — this file is the template.

# --- Gmail (Edge Function ingest-alerts + GitHub Actions statement jobs) ---
# OAuth desktop client credentials for the read-only Gmail API access used to
# fetch bank alert emails and statement attachments.
GMAIL_CLIENT_ID=<YOUR_GMAIL_OAUTH_CLIENT_ID>
GMAIL_CLIENT_SECRET=<YOUR_GMAIL_OAUTH_CLIENT_SECRET>
# Long-lived refresh token minted via scripts/setup_secrets.sh, scoped to
# gmail.readonly only.
GMAIL_REFRESH_TOKEN=<YOUR_GMAIL_REFRESH_TOKEN>

# --- Anthropic (Edge Function ingest-alerts + GitHub Actions reconcile job) ---
# Used to parse structured transaction data out of bank alert emails.
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# --- Supabase (Edge Functions + GitHub Actions) ---
# Project REST URL, e.g. https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
# Service role key — bypasses RLS. Never expose this to the dashboard/browser.
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# --- Cron auth (Edge Functions, checked against a Supabase Vault-held bearer token) ---
# Shared secret every Edge Function checks the pg_cron -> pg_net bearer
# token against. Generate with: openssl rand -base64 32
CRON_SHARED_SECRET=<YOUR_CRON_SHARED_SECRET>

# --- healthchecks.io (Edge Function heartbeat) ---
# Dead-man's-switch ping URL. The only out-of-band failure alarm now that
# Telegram has been removed — required, not optional.
HEALTHCHECKS_PING_URL=https://hc-ping.com/<YOUR_HEALTHCHECKS_UUID>

# --- Statement ingest (GitHub Actions reconcile job, scripts/ingest_statements.py) ---
# Gmail search query used to find statement emails. Optional — falls back to
# a sensible default if unset.
STATEMENT_GMAIL_QUERY=<YOUR_STATEMENT_GMAIL_QUERY>
# Comma-separated candidate passwords tried against encrypted statement PDFs.
STATEMENT_PDF_PASSWORD=<YOUR_STATEMENT_PDF_PASSWORD>
# Optional override of the sender-domain -> payment-method allowlist used to
# route statement emails. See scripts/lib/senders.py for the format and default.
STATEMENT_SENDER_DOMAINS=<YOUR_STATEMENT_SENDER_DOMAINS>
