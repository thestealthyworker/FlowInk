# FlowInk dashboard (Next.js) env vars — the complete list, ever (see
# README.md "Env vars — the complete list, ever"). Both are safe to be
# public: anything prefixed NEXT_PUBLIC_ ships in the browser bundle, and
# RLS — not secrecy of these two values — is the dashboard's real access
# control. No service role key, no Anthropic key, no Gmail credentials
# belong in this project, under any name.
#
# Copy this file to .env.local and fill in the two values:
#   supabase projects api-keys --project-ref <YOUR_SUPABASE_PROJECT_REF>

# Supabase project REST URL, e.g. https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co

# Supabase publishable (anon) key — public by design, RLS-scoped.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
